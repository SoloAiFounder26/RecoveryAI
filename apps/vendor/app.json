{
  "expo": {
    "name": "RecoveryAI Business",
    "slug": "recoveryai-vendor",
    "scheme": "recoveryai-vendor",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080A",
    "ios": {
      "bundleIdentifier": "ai.recovery.vendor",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "RecoveryAI uses Face ID to keep your receivables and debtor details private."
      }
    },
    "android": {
      "package": "ai.recovery.vendor",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "RecoveryAI uses Face ID to keep your receivables and debtor details private."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9dad652c-89b2-4592-9f02-0fa89f57e2e0"
      }
    },
    "owner": "zaravito"
  }
}
