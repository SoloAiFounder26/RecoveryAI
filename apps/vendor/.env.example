# Copy to .env.local and fill in from Supabase > Project Settings > API.
# The publishable/anon key is safe to ship in the app: RLS (fn_my_tenant_id) is what isolates each vendor's data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional, test builds only: "<email>:<code>" signs in without Supabase Auth and shows sample data.
# EXPO_PUBLIC_DEMO_LOGIN=demo@recoveryai.in:123456
# RecoveryAI web app whose /api/* routes the app calls for reminders, voice notes, import, profile, team, support, signup.
EXPO_PUBLIC_WEB_API_URL=https://app.zaravito.com
